---
// ri:menu-fill from Iconify, inlined so the site does not depend on icon packages.
const props = Astro.props;

const viewBox = "0 0 24 24";
const content = `<path fill="currentColor" d="M3 4h18v2H3zm0 7h18v2H3zm0 7h18v2H3z"/>`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1em"
  height="1em"
  viewBox={viewBox}
  {...props}
  set:html={content}
/>
